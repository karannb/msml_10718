# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: any Gemini model with a free tier, e.g. gemini-3.7-flash (stronger, 5 requests/min)
GEMINI_MODEL=gemini-3.1-flash-lite
# Evaluation (evaluate.py --judge): any OpenAI-compatible endpoint
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
# Bearer token for a system under test (run_system.py --auth-env SYSTEM_API_TOKEN)
SYSTEM_API_TOKEN=
